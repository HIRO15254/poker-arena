{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vcode-poker-arena",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "account_id": "66e1835275dae08f3ba17c9c12371b8f",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poker-arena",
      "database_id": "7f240d05-5459-4482-8b2c-7f6a33491f7e"
    }
  ],
  "routes": [{ "pattern": "vcode-poker-arena.hiro15254.com", "custom_domain": true }],
  // リーグは1時間に1ラウンド。持ち主が異なる bot 同士を総当たりで戦わせる。
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
